{
  "name": "discord-bot-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A clean discord.js v14 slash-command bot template with typed config, loaders, cooldowns and error handling.",
  "license": "MIT",
  "author": "Dex",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "deploy": "tsx --env-file=.env src/deploy-commands.ts",
    "deploy:global": "tsx --env-file=.env src/deploy-commands.ts --global",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
